+# pi saves the models a provider discovers at runtime -- the ones a pi extension adds, like the
+# Claude Code add-on's ``claude-code/...`` -- in ``models-store.json`` in each pi config dir, shaped
+# ``{provider_id: {"models": [model, ...], ...}}`` with the same model fields as the bundled data.
+# Those providers are not in pi-ai's bundled data, so without them the catalog refuses their models
+# (at create and on the model bar) and the chip cannot label them. Every pi agent of this host has
+# its own config dir (``PI_CONFIG_DIR_RELPATH`` under its state dir), so the host's agents are where
+# those stores are: a model shows up once any pi agent here has run with the extension.
+_MODELS_STORE_NAME: str = "models-store.json"
+# How long a scan of the saved stores is reused before the stores are read again.
+_EXTENSION_RESCAN_SECONDS: float = 30.0
+# The last scan, by the agents dir it read: when it ran and what it found.
+_EXTENSION_SCANS: dict[Path, tuple[float, tuple[tuple[str, tuple[str, ...]], ...]]] = {}
+
+
+def _model_store_paths(agents_dir: Path) -> list[Path]:
+    """Every pi agent's saved model store under ``agents_dir``, in a stable order."""
+    return sorted(agents_dir.glob(f"*/{PI_CONFIG_DIR_RELPATH}/{_MODELS_STORE_NAME}"))
+
+
+def read_extension_entries(
+    store_paths: list[Path], bundled_providers: frozenset[str]
+) -> tuple[tuple[str, tuple[str, ...]], ...]:
+    """Catalog entries for the models saved in ``store_paths`` whose provider pi-ai does not bundle.
+
+    A bundled provider's saved models are left to its bundled data (the catalog's master list). The
+    first store to name a model decides its efforts; a malformed store or model is skipped.
+    """
+    entries: dict[str, tuple[str, ...]] = {}
+    for path in store_paths:
+        for provider_id, record in read_json_dict(path).items():
+            if provider_id in bundled_providers or not isinstance(record, dict):
+                continue
+            models = record.get("models")
+            if not isinstance(models, list):
+                continue
+            for model in models:
+                if isinstance(model, dict) and isinstance(model.get("id"), str) and model["id"]:
+                    entries.setdefault(f"{provider_id}/{model['id']}", _supported_thinking_levels(model))
+    return tuple(sorted(entries.items()))
+
+
+def _extension_entries(bundled_providers: frozenset[str]) -> tuple[tuple[str, tuple[str, ...]], ...]:
+    """``read_extension_entries`` over this host's stores, re-read at most every ``_EXTENSION_RESCAN_SECONDS``."""
+    agents_dir = get_host_dir() / "agents"
+    now = time.monotonic()
+    previous = _EXTENSION_SCANS.get(agents_dir)
+    if previous is not None and now - previous[0] < _EXTENSION_RESCAN_SECONDS:
+        return previous[1]
+    entries = read_extension_entries(_model_store_paths(agents_dir), bundled_providers)
+    _EXTENSION_SCANS.clear()
+    _EXTENSION_SCANS[agents_dir] = (now, entries)
+    return entries
+
+
