+def test_get_harnesses_lists_a_model_a_pi_extension_saved_with_its_efforts(
+    client: FlaskClient, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """A model a pi extension adds (saved in an agent's ``models-store.json``) is in pi's served catalog, so the
+    picker can offer it and the chip can label it."""
+    put_stand_in_pi_on_path(tmp_path / "pi", "openrouter", ["vendor/first-model"], monkeypatch)
+    store = Path(os.environ["MNGR_HOST_DIR"]) / "agents" / "agent-1" / "plugin" / "pi_coding" / "models-store.json"
+    store.parent.mkdir(parents=True)
+    store.write_text(
+        json.dumps(
+            {
+                "claude-code": {
+                    "models": [
+                        {
+                            "id": "claude-opus-5-5",
+                            "reasoning": True,
+                            "thinkingLevelMap": {"off": None, "minimal": None},
+                        }
+                    ]
+                }
+            }
+        )
+    )
+    pi = client.get("/api/harnesses").get_json()["pi-coding"]
+    by_id = {option["id"]: option for option in pi["options"]}
+    assert list(by_id) == ["openrouter/vendor/first-model", "claude-code/claude-opus-5-5"]
+    assert by_id["claude-code/claude-opus-5-5"]["label"] == "claude-code/claude-opus-5-5"
+    assert [effort["level"] for effort in by_id["claude-code/claude-opus-5-5"]["efforts"]] == ["low", "medium", "high"]
+
