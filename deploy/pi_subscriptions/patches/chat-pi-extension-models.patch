+# How long the effort re-apply below waits for pi to take up the model, and how often it looks.
+_REAPPLY_WAIT_SECONDS: float = 60.0
+_REAPPLY_POLL_SECONDS: float = 0.5
+
+
+def reapply_effort_after_model_switch(
+    state_dir: Path,
+    intent: dict[str, Any],
+    wait_seconds: float = _REAPPLY_WAIT_SECONDS,
+    poll_seconds: float = _REAPPLY_POLL_SECONDS,
+) -> bool:
+    """Send a model-and-effort switch once more when the model landed but the effort did not.
+
+    mngr's pi lifecycle extension applies a switch's effort BEFORE its model, and pi moves the
+    effort to one the new model has as the model changes: a chat moved to opencode-go/glm-5.3 at
+    "low" (GLM-5.3 offers low, high, max) ends on "high". With the model already in place, the
+    same intent again changes only the effort, which then holds. Waits for the first intent to be
+    consumed and for ``model_state.json`` to show the model; returns whether it re-sent.
+    """
+    control_path = state_dir / _CONTROL_NAME
+    deadline = time.monotonic() + wait_seconds
+    # Nothing signals when pi consumes the mailbox, so this polls; the event is never set.
+    never_set = threading.Event()
+    while time.monotonic() < deadline:
+        never_set.wait(timeout=poll_seconds)
+        if control_path.exists():
+            continue
+        state = read_json_dict(state_dir / "model_state.json")
+        if state.get("model") != intent["model_id"]:
+            continue
+        if state.get("effort") == intent["thinking_level"]:
+            return False
+        try:
+            atomic_write(control_path, json.dumps(intent))
+        except OSError as e:
+            logger.warning("pi switch: failed to re-send the effort to {}: {}", control_path, e)
+            return False
+        return True
+    return False
+
+
